{
  "name": "guess-the-impostor",
  "private": true,
  "version": "0.1.0",
  "description": "Cricket-themed Guess the Impostor party game",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @gti/server dev",
    "dev:web": "pnpm --filter @gti/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
